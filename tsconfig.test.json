// The build compiles only shippable code into dist/, so tsconfig.json excludes
// the tests. They still need checking, though: node --test strips their types
// without looking at them, so a fixture can drift from the type it claims
// without anything reporting it. This project checks them, and emits nothing.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
